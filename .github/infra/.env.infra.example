# ─────────────────────────────────────────────────────────────────────────────
# Sharexpress Infrastructure Environment Variables
# Copy to /opt/sharexpress-infra/.env on the VPS and fill in real values.
# NEVER commit the real .env file.
# ─────────────────────────────────────────────────────────────────────────────

# MongoDB
MONGO_ROOT_USER=sharexpress
MONGO_ROOT_PASSWORD=change_me_mongo_root_password
MONGO_APP_PASSWORD=change_me_mongo_app_password

# Redis
REDIS_PASSWORD=change_me_redis_password

# PostgreSQL
POSTGRES_USER=sharexpress
POSTGRES_PASSWORD=change_me_postgres_password

# MinIO Object Storage
MINIO_ROOT_USER=sharexpress
MINIO_ROOT_PASSWORD=change_me_minio_password_min_8_chars
