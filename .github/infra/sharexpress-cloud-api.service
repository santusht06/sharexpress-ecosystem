# ─────────────────────────────────────────────────────────────────────────────
# Sharexpress Cloud — FastAPI Backend (systemd service)
#
# Install:
#   sudo cp sharexpress-cloud-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now sharexpress-cloud-api
# ─────────────────────────────────────────────────────────────────────────────

[Unit]
Description=Sharexpress Cloud API (FastAPI / uvicorn)
After=network.target mongodb.service redis.service
Wants=mongodb.service redis.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/sharexpress-cloud/backend
EnvironmentFile=/opt/sharexpress-cloud/backend/.env

ExecStart=/opt/sharexpress-cloud/backend/.venv/bin/uvicorn \
  main:app \
  --host 0.0.0.0 \
  --port 8000 \
  --workers 2 \
  --loop uvloop \
  --access-log

Restart=always
RestartSec=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sharexpress-cloud-api

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/sharexpress-cloud/backend

[Install]
WantedBy=multi-user.target
